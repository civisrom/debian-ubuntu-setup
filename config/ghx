#!/usr/bin/env python3
"""Маршрутизация gh и SSH по метке; значения токенов не выводятся."""
import os
from pathlib import Path
import re
import subprocess
import sys


def fail(message):
    sys.exit('ghx: ' + message)


def main():
    registry = Path.home() / '.config/github-repos.tsv'
    rows = {}
    for line in registry.read_text().splitlines():
        if not line.strip() or line.lstrip().startswith('#'):
            continue
        fields = line.split()
        if len(fields) != 5:
            fail('ожидаются пять столбцов в github-repos.tsv')
        label, account, host, repos, token_env = fields
        if not all(re.fullmatch(r'[A-Za-z0-9_-]+', x) for x in (label, account, host)):
            fail('некорректная маршрутизация')
        if not re.fullmatch(r'GITHUB_TOKEN_[A-Z0-9_]+', token_env):
            fail('некорректное имя переменной токена')
        rows[label] = (account, host, repos, token_env)

    args = sys.argv[1:]
    if not args:
        fail('команды: list | vars | run LABEL GH_ARGS... | api LABEL PATH | clone LABEL REPO [DIR] | remote LABEL REPO [NAME]')
    action = args.pop(0)
    if action == 'list':
        print('LABEL\tACCOUNT\tSSH_HOST\tREPOS\tTOKEN_ENV\tPRESENT')
        for label, row in rows.items():
            print('\t'.join((label, *row, 'yes' if os.environ.get(row[3]) else 'no')))
        return
    if action == 'vars':
        # Явно разрешённый пользователем вывод только имён, никогда значений.
        result = subprocess.run(['grep', '-oE', 'GITHUB_TOKEN[A-Z0-9_]*', str(Path.home()/'.config/secrets.env')], capture_output=True, text=True)
        if result.returncode not in (0, 1):
            fail('не удалось определить имена переменных')
        print('\n'.join(sorted(set(result.stdout.splitlines()))))
        return
    if action not in ('run', 'api', 'clone', 'remote') or len(args) < 2:
        fail('некорректные аргументы')
    label = args.pop(0)
    if label not in rows:
        fail('неизвестная метка аккаунта')
    account, host, repos, token_env = rows[label]
    if action in ('run', 'api'):
        token = os.environ.get(token_env)
        if not token:
            fail('токен отсутствует в окружении; проверьте .zshenv и права secrets.env')
        child_env = os.environ.copy()
        child_env['GH_TOKEN'] = token
        child_env['GH_HOST'] = 'github.com'
        os.execvpe('gh', ['gh', *(['api'] if action == 'api' else []), *args], child_env)
    repo = args.pop(0)
    if not re.fullmatch(r'[A-Za-z0-9_.-]+', repo) or repo.startswith('.'):
        fail('ожидается короткое имя репозитория')
    if repos != '*' and repo not in repos.split(','):
        fail('репозиторий не относится к указанной метке')
    url = f'git@{host}:{account}/{repo}.git'
    if action == 'clone':
        if len(args) > 1:
            fail('слишком много аргументов')
        root = Path.home() / 'codex_project'
        destination = Path(args[0]).resolve() if args else root / repo
        if not destination.is_relative_to(root.resolve()):
            fail('рабочие клоны должны находиться в ~/codex_project')
        os.execvp('git', ['git', 'clone', url, str(destination)])
    if len(args) > 1:
        fail('слишком много аргументов')
    name = args[0] if args else 'origin'
    if not re.fullmatch(r'[A-Za-z0-9_-]+', name):
        fail('некорректное имя remote')
    existing = subprocess.check_output(['git', 'remote'], text=True).splitlines()
    os.execvp('git', ['git', 'remote', 'set-url' if name in existing else 'add', name, url])


if __name__ == '__main__':
    main()
